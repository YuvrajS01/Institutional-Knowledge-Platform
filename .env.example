# ------------------------------------------------------------------
# Institutional Knowledge Platform — local development environment
# Copy to `.env` and adjust as needed. Never commit `.env`.
# ------------------------------------------------------------------

# Runtime
NODE_ENV=development

# Web application
APP_URL=http://localhost:3000
# NEXT_PUBLIC_API_URL=http://localhost:4000

# API server
API_URL=http://localhost:4000
API_HOST=0.0.0.0
API_PORT=4000

# Worker health server
WORKER_HOST=0.0.0.0
WORKER_PORT=4100

# Logging (fatal | error | warn | info | debug | trace | silent)
LOG_LEVEL=info

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/institutional_knowledge

# Isolated test database (used by the integration test suite)
# DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/institutional_knowledge_test

# Queue / cache (Redis)
REDIS_URL=redis://localhost:6379

# Authentication (JWT)
# Minimum 32 characters. The dev default below is rejected in production.
JWT_SECRET=insecure-dev-only-secret-change-me-0123456789
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# S3-compatible object storage (MinIO default for local development)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=institutional-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- Optional AI provider configuration (used from Phase 3 onward) ---
# LLM provider: mock (default, deterministic) | local | ollama | openai | vllm | http
# LLM_PROVIDER=mock
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=qwen2:7b
# Optional full endpoint override (e.g., http://localhost:11434/api/generate or http://localhost:8000/v1/chat/completions)
# LLM_ENDPOINT=http://localhost:11434/api/generate
# Embedding provider: mock (default, deterministic, no network) | local | ollama | openai | vllm | http
# EMBEDDING_PROVIDER=mock
# For local/Ollama (BGE-M3 default, 1024 dims):
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_BASE_URL=http://localhost:11434
# Optional full endpoint override (e.g., http://localhost:11434/api/embed or http://localhost:8000/v1/embeddings)
# EMBEDDING_ENDPOINT=http://localhost:11434/api/embed
# Optional dimension override (1024 for BGE-M3, 384 for minilm, etc.)
# EMBEDDING_DIMENSIONS=1024
# Metadata extraction provider: heuristic (default, deterministic) | llm | local | ollama | openai | vllm | http | mock
# METADATA_PROVIDER=heuristic
# When METADATA_PROVIDER=llm|local|... the LLM provider above is used for metadata extraction (qwen-class 7B/8B recommended)
# Date extraction provider: heuristic (default, deterministic) | llm | local | ollama | openai | vllm | http | mock
# DATE_PROVIDER=heuristic
# When DATE_PROVIDER=llm|local|... the LLM provider above is used for important-date extraction (same qwen-class model)
# Reranker provider: mock (default, heuristic token-overlap) | local | ollama | vllm | openai | http | bge
# RERANKER_PROVIDER=mock
# RERANKER_MODEL=bge-reranker-base
# RERANKER_BASE_URL=http://localhost:11434
# Optional full endpoint override (e.g., http://localhost:11434/rerank or http://localhost:8000/v1/rerank)
# RERANKER_ENDPOINT=http://localhost:11434/rerank
# OCR_PROVIDER=local
