{
  "name": "@ikp/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "node-pg-migrate up -m ../../infra/migrations --envPath ../../.env",
    "db:migrate:down": "node-pg-migrate down -m ../../infra/migrations --envPath ../../.env",
    "db:seed": "tsx ../../infra/scripts/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@ikp/config": "workspace:*",
    "@ikp/shared": "workspace:*",
    "bcryptjs": "^3.0.0",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.0",
    "jose": "^5.9.0",
    "node-pg-migrate": "^7.0.0",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
