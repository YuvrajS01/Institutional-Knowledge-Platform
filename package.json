{
  "name": "institutional-knowledge-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Institutional document and knowledge platform",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter @ikp/shared --filter @ikp/config build",
    "dev": "pnpm build:packages && pnpm -r --parallel dev",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm build:packages && pnpm -r typecheck && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:security": "vitest run tests/integration/security",
    "db:migrate": "pnpm --filter @ikp/api db:migrate",
    "db:migrate:down": "pnpm --filter @ikp/api db:migrate:down",
    "db:seed": "pnpm build:packages && pnpm --filter @ikp/api db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "canvas",
      "esbuild",
      "next",
      "sharp"
    ]
  }
}
